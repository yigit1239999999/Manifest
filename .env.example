# --- Database (Supabase Postgres) ---
# Grab these from Supabase: Project → Connect → ORM tab (Prisma).
# DATABASE_URL  = pooled connection, used by the running app.
# DIRECT_URL    = direct connection, used for schema migrations (prisma db push).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres"

# --- Auth.js ---
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
