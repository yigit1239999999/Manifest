# Yerelde elle doldurmak yerine: Vercel'de tanımlı değerleri tek komutla
# indirin (bir kez `npx vercel login` ve `npx vercel link`, sonra her seferinde):
#
#   npm run env:pull
#
# Bu, üretimdeki DATABASE_URL / DIRECT_URL / AUTH_SECRET değerlerini .env'e
# yazar. Aşağısı, elle doldurmak isteyenler için şablondur.

# --- Database (Supabase Postgres) ---
# Grab these from Supabase: Project → Connect → ORM tab (Prisma).
# DATABASE_URL  = pooled connection, used by the running app.
# DIRECT_URL    = direct connection, used for schema migrations (prisma db push).
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres"

# --- Auth.js ---
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# --- Spreadsheet import, column matching (optional) ---
# With a key, columns the import cannot name are asked of Claude: headings
# and masked samples only, never rows. Without it, matching is local only.
ANTHROPIC_API_KEY=""
