// PetTrack — full-scale veterinary CRM + pet management
// Multi-tenant: every tenant-scoped record belongs to a Clinic via `clinicId`.
//
// Money is stored as integer cents (`*Cents`) to avoid float/Decimal pitfalls.
// Soft delete is via `archivedAt DateTime?` on entities where history matters.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===========================================================================
// Tenant root
// ===========================================================================

model Clinic {
  id                String    @id @default(cuid())
  name              String
  email             String?
  phone             String?
  address           String?
  city              String?
  postalCode        String?
  country           String?
  timezone          String    @default("Europe/Istanbul")
  currency          String    @default("TRY")
  settings          Json?
  /// DELIBERATELY UNREAD. Nothing in the product writes or reads this
  /// today, and that is a design decision rather than an oversight.
  ///
  /// It was going to let a clinic close the first-step card. The card
  /// names the one missing link of the mandatory chain and removes
  /// itself the moment that link exists, so the only clinic that keeps
  /// seeing it is one that has not started -- and the card is then
  /// saying something true. A dismiss button would take that sentence
  /// off the screen and leave the situation where it was, and it would
  /// also remove the only thing pointing the way during a clinic's
  /// first week. Two vets met the card and both watched it disappear on
  /// its own; neither asked to close one.
  ///
  /// The column stays rather than being dropped because the migration
  /// is already applied to a shared database and a second migration to
  /// undo it costs more than a nullable column nobody reads.
  ///
  /// What would make it live, so the next reader does not have to guess:
  /// a real clinic saying it cannot close the card. On that day the
  /// condition is that it must also be possible to bring the card back
  /// -- no one-way door -- which is why this is a timestamp and not a
  /// boolean: "never closed", "closed on this day" and "put back" are
  /// three facts, and undo writes null so the first and the third are
  /// the same state.
  firstStepHiddenAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  users         User[]
  clients       Client[]
  pets          Pet[]
  customSpecies CustomSpecies[]
  visits        Visit[]
  appointments  Appointment[]
  vaccinations  Vaccination[]
  prescriptions Prescription[]
  treatments    Treatment[]
  diagnostics   Diagnostic[]
  notes         Note[]
  reminders     Reminder[]
  invoices      Invoice[]
  documents     Document[]
  auditLogs     AuditLog[]
  messages      MessageLog[]
  importBatches ImportBatch[]

  @@map("clinics")
}

// ===========================================================================
// Users (clinic staff)
// ===========================================================================

enum UserRole {
  ADMIN
  VETERINARIAN
  VET_TECH
  RECEPTIONIST
}

model User {
  id                String    @id @default(cuid())
  clinicId          String
  clinic            Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name              String
  email             String    @unique
  passwordHash      String
  role              UserRole  @default(VETERINARIAN)
  phone             String?
  active            Boolean   @default(true)
  lastLoginAt       DateTime?
  /// Timestamp of the last password change. Any JWT whose `iat` is older
  /// than this value is rejected so a compromised password kicks all
  /// existing sessions.
  passwordChangedAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  visitsAsVet       Visit[]        @relation("VetForVisit")
  appointmentsAsVet Appointment[]  @relation("VetForAppointment")
  prescriptionsBy   Prescription[] @relation("PrescribedBy")
  treatmentsBy      Treatment[]    @relation("TreatmentBy")
  vaccinationsBy    Vaccination[]  @relation("VaccinationBy")
  diagnosticsRead   Diagnostic[]   @relation("DiagnosticReadBy")
  notesBy           Note[]         @relation("NoteAuthor")
  documentsBy       Document[]     @relation("DocumentUploadedBy")
  auditLogs         AuditLog[]     @relation("AuditActor")
  importBatches     ImportBatch[]  @relation("ImportBatchCreator")
  paymentsVoided    Payment[]      @relation("PaymentVoidedBy")

  @@index([clinicId])
  @@map("users")
}

// ===========================================================================
// Clients (pet owners) — the CPM side
// ===========================================================================

enum ContactMethod {
  EMAIL
  PHONE
  SMS
}

/// The path a consent answer came in by. Derived from the code path that
/// wrote it, never asked of staff: a "where did this consent come from?"
/// dropdown is filled in empty or wrong. One path exists today, so there
/// is one value, and that is not a gap.
enum ConsentSource {
  /// The client form in the app, filled in by clinic staff.
  STAFF_FORM
}

model Client {
  id                       String         @id @default(cuid())
  clinicId                 String
  clinic                   Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  firstName                String
  /// Null when nobody asked, and that is not the same as empty.
  ///
  /// The counter meets a client who is standing there with an animal:
  /// "I do not know the surname of the lady who brings the street cat,
  /// and asking would be rude -- if you force it I will type a full
  /// stop and the record becomes rubbish" (vet, measured). So the form
  /// stopped demanding it, and this column had to stop demanding it
  /// too: an empty string would be an answer where there is none, it
  /// sorts and searches as a real value, and six months from now
  /// "how many clients are missing a surname" would have no answer.
  /// The same distinction `notificationsOptIn` keeps, one column up.
  ///
  /// `searchKey` already coalesces it, so full-name search is
  /// unaffected by the null.
  lastName                 String?
  email                    String?
  phone                    String?
  secondaryPhone           String?
  address                  String?
  city                     String?
  postalCode               String?
  country                  String?
  preferredContact         ContactMethod?
  /// BCP 47 language for outbound messages ("tr" | "en"). Null falls back
  /// to the clinic's default.
  preferredLanguage        String?
  /// Per-client switch for automatic SMS/WhatsApp messages (appointments,
  /// reminders). Timing is a clinic setting; this is the client's consent.
  ///
  /// Three states, and nothing may quietly turn one into another:
  ///   null  - nobody has asked yet
  ///   true  - the client agreed
  ///   false - the client refused
  ///
  /// It used to be `Boolean @default(false)`, so a client born unasked was
  /// recorded as having refused, on the day the record was created. The
  /// two are not the same thing and only one of them is a fact: "not
  /// asked" is work still to do, "refused" is an answer to respect. Both
  /// sides of the column have to keep them apart - see the form field in
  /// `modules/clients/schema.ts`, where an absent control must write
  /// nothing rather than `false`.
  notificationsOptIn       Boolean?
  /// When the answer in `notificationsOptIn` was recorded, and by which
  /// path. Proof of consent is a time and a source; a bare boolean is a
  /// claim. Both are stamped only when the answer changes, so re-saving
  /// an address does not move the date of a consent given a year ago.
  ///
  /// Null on every row answered before these columns existed, and that
  /// is deliberate: back-filling `createdAt` would manufacture proof, and
  /// a forged proof is worse than none. "We do not know" is the truth.
  notificationsOptInAt     DateTime?
  notificationsOptInSource ConsentSource?
  marketingOptIn           Boolean        @default(false)
  notes                    String?
  /// Accent-folded first name, last name, email and phone, joined by
  /// spaces. A STORED generated column: Postgres writes it, nothing here
  /// ever may, and `20260921190000_search_key_accent_folded` holds the
  /// expression and its trigram index. Searches compare it against a
  /// term folded by `lib/search.ts`; the two must agree, and
  /// `scripts/fold-parity.mjs` is what checks that they do.
  ///
  /// Two defects were closed by this one column, and the second is the
  /// reason the join is not an implementation detail. Searching a full
  /// name never worked at all: first and last name are separate
  /// columns, and no OR over them can span the space between the words.
  /// Measured before the change, "Yiğit Sonbahar" returned 0 rows, and
  /// so did "Yigit Sonbahar" -- it was never an accent problem. Anyone
  /// simplifying this to "unaccent is enough" takes the full-name search
  /// away again, and nothing on screen will connect the two.
  searchKey                String?
  /// The spreadsheet import that created this row, and nothing else.
  ///
  /// Set only when the import CREATED the client. A client the import
  /// matched to an existing record keeps a null here, because undoing the
  /// import must not be able to delete somebody the vet typed in
  /// themselves -- see `modules/import/service.ts`, where undo is
  /// "delete the rows carrying this batch" and that sentence is only
  /// safe while this column means "we made this one".
  importBatchId            String?
  importBatch              ImportBatch?   @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  archivedAt               DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  pets         Pet[]
  appointments Appointment[]
  visits       Visit[]
  invoices     Invoice[]
  /// Note rows whose `clientId` points here. Named `_rel` because the
  /// short field name `notes` is reserved further down on Clinic (which
  /// would create a naming conflict in the generated Prisma client).
  notes_rel    Note[]
  documents    Document[]
  reminders    Reminder[]
  messages     MessageLog[]

  @@index([clinicId])
  @@index([clinicId, lastName, firstName])
  @@index([clinicId, email])
  @@index([clinicId, phone])
  @@index([clinicId, archivedAt])
  @@index([clinicId, createdAt(sort: Desc)])
  /// Undo reads by batch, so the batch leads. `clinicId` is still in front
  /// of it: every query in this product is clinic-scoped, and an index
  /// that is not costs more as the table grows rather than less.
  @@index([clinicId, importBatchId])
  @@map("clients")
}

// ===========================================================================
// Pets (patients) — the CRM side
// ===========================================================================

enum Species {
  DOG
  CAT
  BIRD
  RABBIT
  RODENT
  FERRET
  REPTILE
  AMPHIBIAN
  FISH
  HORSE
  CATTLE
  SHEEP
  GOAT
  EXOTIC
  OTHER
}

enum Sex {
  MALE
  FEMALE
  UNKNOWN
}

model Pet {
  id                String         @id @default(cuid())
  clinicId          String
  clinic            Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  ownerId           String
  owner             Client         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name              String
  species           Species
  /// Clinic-defined species ("her kliniğin kendi dünyası"). When set, the
  /// enum column holds OTHER and this row's name is the display species.
  customSpeciesId   String?
  customSpecies     CustomSpecies? @relation(fields: [customSpeciesId], references: [id], onDelete: SetNull)
  breed             String?
  sex               Sex            @default(UNKNOWN)
  neutered          Boolean        @default(false)
  birthDate         DateTime?
  color             String?
  weightKg          Float?
  microchipId       String?
  insuranceProvider String?
  insurancePolicy   String?
  photoUrl          String?
  alerts            String?
  deceased          Boolean        @default(false)
  deceasedAt        DateTime?
  archivedAt        DateTime?
  notes             String?
  /// Accent-folded name, breed and microchip id. See `Client.searchKey`
  /// -- same generated column, same migration. The owner's name is not
  /// in here: a generated column cannot read another table, so a search
  /// for an owner goes through `owner.searchKey`.
  searchKey         String?
  /// The spreadsheet import that created this animal. See
  /// `Client.importBatchId` -- same column, same promise, same undo.
  importBatchId     String?
  importBatch       ImportBatch?   @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  visits        Visit[]
  appointments  Appointment[]
  vaccinations  Vaccination[]
  prescriptions Prescription[]
  treatments    Treatment[]
  diagnostics   Diagnostic[]
  /// Note rows whose `petId` points here. Named `_rel` to avoid the
  /// Prisma naming clash with Clinic.notes.
  notes_rel     Note[]
  documents     Document[]
  reminders     Reminder[]
  invoiceLines  InvoiceLine[]

  @@index([clinicId])
  @@index([customSpeciesId])
  @@index([clinicId, ownerId])
  @@index([clinicId, name])
  @@index([clinicId, microchipId])
  @@index([clinicId, archivedAt])
  @@index([clinicId, importBatchId])
  @@map("pets")
}

/// One run of the spreadsheet import, so it can be undone as one thing.
///
/// A row exists because of what happens AFTER the import: the vet closes
/// the screen, opens the client list, and sees two hundred rows they now
/// have to judge. Without this table "undo" would mean selecting them by
/// hand, and an import nobody dares to run is not an import. With it,
/// undo is one statement over one indexed column.
///
/// `undoneAt` rather than deleting the batch row: what was imported and
/// then taken back is a fact about the clinic's day, and the audit log
/// points at this id.
model ImportBatch {
  id               String    @id @default(cuid())
  clinicId         String
  clinic           Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  /// Null once the user is gone; the batch and its undo outlive them.
  createdById      String?
  createdBy        User?     @relation("ImportBatchCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// The vet's own file name, shown back to them when they pick a batch
  /// to undo. "musteriler-2024.xlsx" is how they know which run this was;
  /// a timestamp alone is not.
  fileName         String
  sheetName        String
  /// What this run actually created, counted at commit time. Kept here
  /// rather than counted on demand so the list of batches is one query
  /// no matter how many batches there are, and so the numbers still read
  /// correctly after the rows are undone and gone.
  clientCount      Int       @default(0)
  petCount         Int       @default(0)
  /// How many existing clients the run attached animals to. Not
  /// deletable by undo and not counted with the created ones.
  mergedCount      Int       @default(0)
  /// Vaccination records the run wrote, read off the file's vaccine
  /// columns. Counted at commit time like the two above.
  vaccinationCount Int       @default(0)
  undoneAt         DateTime?
  createdAt        DateTime  @default(now())

  clients      Client[]
  pets         Pet[]
  vaccinations Vaccination[]

  @@index([clinicId, createdAt(sort: Desc)])
  @@map("import_batches")
}

/// Clinic-defined species beyond the built-in enum (e.g. "Kirpi", "At").
/// Created on the fly from the pet form's species combobox.
model CustomSpecies {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name      String
  /// Accent-folded `name`, generated by Postgres. Two clinics may both
  /// have a "Köpek"; one clinic may not have both "Köpek" and "Kopek",
  /// and the unique index below is what makes that true even when two
  /// requests add it in the same second. See
  /// `20260921200000_custom_species_folded_unique`.
  nameKey   String?
  createdAt DateTime @default(now())

  pets Pet[]

  @@unique([clinicId, name])
  @@unique([clinicId, nameKey])
  @@index([clinicId])
  @@map("custom_species")
}

// ===========================================================================
// Appointments
// ===========================================================================

enum VisitType {
  WELLNESS_CHECK
  VACCINATION
  SICK_VISIT
  EMERGENCY
  SURGERY
  DENTAL
  GROOMING
  FOLLOWUP
  TELEHEALTH
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id              String            @id @default(cuid())
  clinicId        String
  clinic          Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  petId           String
  pet             Pet               @relation(fields: [petId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vetId           String?
  vet             User?             @relation("VetForAppointment", fields: [vetId], references: [id], onDelete: SetNull)
  startsAt        DateTime
  durationMinutes Int               @default(30)
  type            VisitType         @default(WELLNESS_CHECK)
  status          AppointmentStatus @default(SCHEDULED)
  reason          String?
  notes           String?
  visit           Visit?
  messages        MessageLog[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([clinicId, startsAt])
  @@index([clinicId, vetId, startsAt])
  @@index([clinicId, petId])
  @@index([clinicId, status, startsAt])
  // One more index exists that is not written here: a UNIQUE index on
  // (clinicId, petId, startsAt) WHERE status <> 'CANCELLED', added in
  // `20260921140000_one_appointment_per_animal_per_instant`. Prisma cannot
  // express a partial unique index, so it lives in the migration alone —
  // noted here because a model that looks like it permits duplicates is
  // how someone comes to rely on that.
  @@map("appointments")
}

// ===========================================================================
// Visits (encounters) — the heart of the medical history
// ===========================================================================

model Visit {
  id                 String       @id @default(cuid())
  clinicId           String
  clinic             Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  petId              String
  pet                Pet          @relation(fields: [petId], references: [id], onDelete: Cascade)
  clientId           String
  client             Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  vetId              String?
  vet                User?        @relation("VetForVisit", fields: [vetId], references: [id], onDelete: SetNull)
  appointmentId      String?      @unique
  appointment        Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  visitedAt          DateTime     @default(now())
  type               VisitType    @default(WELLNESS_CHECK)
  chiefComplaint     String?
  // SOAP
  subjective         String?
  objective          String?
  assessment         String?
  plan               String?
  // Vitals
  weightKg           Float?
  temperatureC       Float?
  heartRateBpm       Int?
  respiratoryRateBpm Int?
  followupAt         DateTime?
  totalCents         Int?
  /// Set whenever `totalCents` is. See the visit service: a total without
  /// the currency it was recorded in is a number the clinic's next
  /// settings change silently restates.
  currency           String?
  archivedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  vaccinations  Vaccination[]
  prescriptions Prescription[]
  treatments    Treatment[]
  diagnostics   Diagnostic[]
  documents     Document[]
  invoiceLines  InvoiceLine[]

  @@index([clinicId, visitedAt])
  @@index([clinicId, petId, visitedAt])
  @@index([clinicId, clientId])
  @@index([clinicId, archivedAt])
  @@map("visits")
}

// ===========================================================================
// Vaccinations
// ===========================================================================

/// Where a next-due interval came from. See `Vaccination.nextDueSource`.
enum DueSource {
  /// Measured from this clinic's own records for this vaccine and species.
  HISTORY
  /// An interval this clinic typed into its own vaccine list (settings).
  /// Deliberately not folded into LIST: one is their claim, the other is
  /// ours, and a record that cannot tell them apart cannot be questioned.
  CLINIC
  /// The list the product ships with (`lib/vaccines.ts`).
  LIST
  /// Typed by a person, agreeing with neither or asked for by the list.
  MANUAL
}

model Vaccination {
  id                   String        @id @default(cuid())
  clinicId             String
  clinic               Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  petId                String
  pet                  Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)
  visitId              String?
  visit                Visit?        @relation(fields: [visitId], references: [id], onDelete: SetNull)
  administeredById     String?
  administeredBy       User?         @relation("VaccinationBy", fields: [administeredById], references: [id], onDelete: SetNull)
  name                 String
  manufacturer         String?
  lotNumber            String?
  administeredAt       DateTime      @default(now())
  nextDueAt            DateTime?
  /// Where the interval behind `nextDueAt` came from, so the screen can
  /// say it out loud. Null when there is no next date, or when the row
  /// predates this column -- and those two are both "we do not know",
  /// which is why nothing is back-filled.
  ///
  /// The distinction is the point of the field: an interval this clinic
  /// has measured for itself and one the product shipped are not the
  /// same claim, and showing them identically is how a default becomes
  /// a medical fact nobody stated (#37, and TEAM.md #14).
  nextDueSource        DueSource?
  /// Which dose of the starting series this is, 1-based, and how many
  /// the series had when it was written.
  ///
  /// The vet's most expensive problem, in their words: "Karma üç doz,
  /// sahibi ikinci dozdan sonra kayboluyor, üç ay sonra geliyor. O an
  /// sorduğum şey 'en son ne zaman' değil, 'kaçıncı dozdaydık'. Emin
  /// olamayınca baştan başlatıyorum, sahibi de boşuna para veriyor."
  /// `nextDueAt` cannot answer that: one date says when, never which.
  ///
  /// `seriesOf` is a SNAPSHOT rather than a lookup. A record says what
  /// was believed when it was written; if the catalogue later says four
  /// doses, a dose recorded as 2/3 stays 2/3, because that is what the
  /// vet was told on the day. Reading the current catalogue instead
  /// would silently restate history.
  doseNumber           Int?
  seriesOf             Int?
  /// Set when somebody closes this overdue row on the dashboard.
  ///
  /// It closes the ROW, not the animal: `Pet.archivedAt` is untouched,
  /// and every other screen still shows this vaccination. "I have dealt
  /// with this one" is a smaller statement than "this animal is gone".
  ///
  /// REQUIRED OF WHOEVER ADDS AN UPDATE PATH: moving `nextDueAt` must
  /// clear this. Changing the date means "I am tracking this animal
  /// again" and the stamp means "I am not", and a record holding both
  /// falls between the two cards -- out of the overdue one because the
  /// date moved, invisible in the upcoming one because of the stamp.
  /// There is no update path today (create and delete only), so a new
  /// date arrives as a new row with no stamp, and the rule holds by
  /// construction rather than by code. That stops being true the day
  /// an edit form lands.
  dueDismissedAt       DateTime?
  /// The spreadsheet run that wrote this row, or null for one typed in
  /// the product. Undo deletes by it, as it does for clients and pets.
  importBatchId        String?
  importBatch          ImportBatch?  @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  /// The file gave a day, not a time. `administeredAt` holds that day at
  /// UTC noon and every screen prints the day alone -- a time of day
  /// here would be one nobody wrote.
  administeredDateOnly Boolean       @default(false)
  /// The next dose of the same vaccine for the same animal, when one was
  /// recorded after this. Its `nextDueAt` is then answered: Badem's Karma
  /// from last year is not overdue once this year's is on file, and the
  /// overdue and upcoming lists skip a superseded row.
  ///
  /// Derived, never typed: `modules/vaccinations/supersede.ts` recomputes
  /// it for an animal whenever one of its vaccinations is written or
  /// removed, matching names through the catalogue's aliases. Points at
  /// the NEXT newer dose rather than the newest, so removing the newest
  /// (an import undone, a row deleted) un-answers exactly one row through
  /// the foreign key's SET NULL, without anything having to recompute.
  supersededById       String?
  supersededBy         Vaccination?  @relation("Supersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes           Vaccination[] @relation("Supersedes")
  site                 String?
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([clinicId, petId, administeredAt])
  @@index([clinicId, nextDueAt])
  @@index([clinicId, importBatchId])
  @@index([supersededById])
  // A third index is not written here: (clinicId, administeredAt DESC)
  // WHERE "nextDueAt" IS NOT NULL, added in
  // `20260921150000_vaccination_suggestion_index` for the next-due
  // suggestion, which reads this table newest-first on two of the busiest
  // screens. Prisma cannot express a partial index, so it lives in the
  // migration; noted here so nobody adds a fourth one for the same query.
  @@map("vaccinations")
}

// ===========================================================================
// Prescriptions
// ===========================================================================

enum PrescriptionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Prescription {
  id             String             @id @default(cuid())
  clinicId       String
  clinic         Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  petId          String
  pet            Pet                @relation(fields: [petId], references: [id], onDelete: Cascade)
  visitId        String?
  visit          Visit?             @relation(fields: [visitId], references: [id], onDelete: SetNull)
  prescribedById String?
  prescribedBy   User?              @relation("PrescribedBy", fields: [prescribedById], references: [id], onDelete: SetNull)
  medicationName String
  dosage         String
  frequency      String
  route          String?
  durationDays   Int?
  refills        Int                @default(0)
  startedAt      DateTime           @default(now())
  endedAt        DateTime?
  status         PrescriptionStatus @default(ACTIVE)
  instructions   String?
  notes          String?
  /// Why this was written although it matches the animal's recorded
  /// allergy (see `lib/allergy-check.ts`). Null when there was no match:
  /// the server refuses a matching drug without one, so a value here is
  /// always a vet's deliberate decision, in their words.
  overrideReason String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([clinicId, petId])
  @@index([clinicId, status])
  @@map("prescriptions")
}

// ===========================================================================
// Treatments / Procedures
// ===========================================================================

model Treatment {
  id              String   @id @default(cuid())
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  petId           String
  pet             Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  visitId         String?
  visit           Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  performedById   String?
  performedBy     User?    @relation("TreatmentBy", fields: [performedById], references: [id], onDelete: SetNull)
  name            String
  code            String?
  performedAt     DateTime @default(now())
  durationMinutes Int?
  notes           String?
  /// Why this was written although it matches the animal's recorded
  /// allergy (see `lib/allergy-check.ts`). Null when there was no match:
  /// the server refuses a matching drug without one, so a value here is
  /// always a vet's deliberate decision, in their words.
  overrideReason  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([clinicId, petId, performedAt])
  @@map("treatments")
}

// ===========================================================================
// Diagnostics (lab / imaging)
// ===========================================================================

enum DiagnosticType {
  BLOOD
  URINE
  FECAL
  CYTOLOGY
  CULTURE
  XRAY
  ULTRASOUND
  MRI
  CT
  ECG
  ENDOSCOPY
  OTHER
}

model Diagnostic {
  id             String         @id @default(cuid())
  clinicId       String
  clinic         Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  petId          String
  pet            Pet            @relation(fields: [petId], references: [id], onDelete: Cascade)
  visitId        String?
  visit          Visit?         @relation(fields: [visitId], references: [id], onDelete: SetNull)
  type           DiagnosticType
  name           String
  performedAt    DateTime       @default(now())
  result         String?
  resultData     Json?
  interpretation String?
  notes          String?
  /// Whether this result came from outside the clinic.
  ///
  /// The read-marker loop applies to these only. Three quarters of a
  /// vet's tests are run in the room: the printout is in their hand
  /// and they turn round and tell the owner, so the result closes in
  /// the conversation. Asking them to press a button afterwards is
  /// asking them to finish a finished job five times a day -- they
  /// stop pressing within the week, unpressed rows pile up, the list
  /// turns red and they stop reading the list. Which is the failure
  /// the list exists to prevent.
  ///
  /// The ones that get lost share one property: the result arrived
  /// while the vet was not in the room. Two or three a week.
  ///
  /// A fact, not a judgement. Not "does this need reading" -- that
  /// would put a decision on whoever types it in. Where it came from
  /// is something they already know.
  ///
  /// Defaults to false, and the two mistakes are not symmetrical:
  /// wrongly marked external fills the list with in-house results and
  /// kills it, wrongly left internal loses one row and the list lives.
  externalLab    Boolean        @default(false)
  /// When the person who decides saw this result, and who they were.
  ///
  /// "The result arrived" and "the vet read it" were the same fact,
  /// and they are not: one is the result reaching the clinic, the
  /// other is it reaching whoever acts on it. A histopathology report
  /// sat in a file for three days with everyone doing their job
  /// correctly, because nobody was asked whether the vet had seen it.
  ///
  /// Deliberately "saw", not "interpreted": a result that needs no
  /// comment would otherwise stay unread for ever, and a count that
  /// cannot reach zero stops being read. Writing `interpretation`
  /// sets this too -- writing a comment is reading.
  readAt         DateTime?
  readById       String?
  readBy         User?          @relation("DiagnosticReadBy", fields: [readById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([clinicId, petId, performedAt])
  /// The unread count's own query: results in a clinic that nobody has
  /// marked, oldest first. Without it that is a scan of every
  /// diagnostic the clinic has ever recorded, on every dashboard load.
  @@index([clinicId, readAt, createdAt])
  @@map("diagnostics")
}

// ===========================================================================
// Notes (timeline entries)
// ===========================================================================

enum NoteKind {
  GENERAL
  PHONE_CALL
  EMAIL
  SMS
  INTERNAL
  EVENT
}

model Note {
  id        String   @id @default(cuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  petId     String?
  pet       Pet?     @relation(fields: [petId], references: [id], onDelete: Cascade)
  kind      NoteKind @default(GENERAL)
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clinicId, petId, createdAt])
  @@index([clinicId, clientId, createdAt])
  @@map("notes")
}

// ===========================================================================
// Reminders
// ===========================================================================

enum ReminderType {
  VACCINATION_DUE
  CHECKUP
  FOLLOWUP
  BIRTHDAY
  CUSTOM
}

enum ReminderStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  DISMISSED
}

model Reminder {
  id        String         @id @default(cuid())
  clinicId  String
  clinic    Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  petId     String?
  pet       Pet?           @relation(fields: [petId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type      ReminderType
  title     String
  body      String?
  dueAt     DateTime
  status    ReminderStatus @default(PENDING)
  sentAt    DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  messages MessageLog[]

  @@index([clinicId, dueAt])
  @@index([clinicId, status])
  @@map("reminders")
}

// ===========================================================================
// Invoices & payments
// ===========================================================================

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  VOID
}

model Invoice {
  id            String        @id @default(cuid())
  clinicId      String
  clinic        Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  number        String
  /**
   * The currency this invoice was issued in, copied from the clinic at the
   * time. Reading a finished invoice through the clinic's *current* setting
   * would silently restate last year's totals the day someone changes it.
   */
  currency      String
  status        InvoiceStatus @default(DRAFT)
  issuedAt      DateTime      @default(now())
  dueAt         DateTime?
  paidAt        DateTime?
  subtotalCents Int           @default(0)
  taxCents      Int           @default(0)
  totalCents    Int           @default(0)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lines    InvoiceLine[]
  payments Payment[]

  @@unique([clinicId, number])
  @@index([clinicId, status])
  @@index([clinicId, clientId])
  @@map("invoices")
}

model InvoiceLine {
  id             String   @id @default(cuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  petId          String?
  pet            Pet?     @relation(fields: [petId], references: [id], onDelete: SetNull)
  visitId        String?
  visit          Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  description    String
  quantity       Int      @default(1)
  unitPriceCents Int
  totalCents     Int
  createdAt      DateTime @default(now())

  @@index([invoiceId])
  /// Both foreign keys, both unindexed until now, and the second one is
  /// about to be read on every visit page: "does this visit already have
  /// an invoice". Postgres does not index a foreign key for you, so that
  /// question was a sequential scan over every line in the database.
  @@index([visitId])
  @@index([petId])
  @@map("invoice_lines")
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CHECK
  OTHER
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountCents Int
  method      PaymentMethod
  paidAt      DateTime      @default(now())
  reference   String?
  notes       String?
  createdAt   DateTime      @default(now())
  /// A payment recorded by mistake is voided, never deleted: the row stays
  /// as the record that money was once entered and then taken back. Every
  /// sum of what an invoice has been paid must filter on `voidedAt: null`.
  voidedAt    DateTime?
  voidedById  String?
  voidedBy    User?         @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason  String?

  @@index([invoiceId])
  @@index([voidedById])
  @@map("payments")
}

// ===========================================================================
// Documents
// ===========================================================================

model Document {
  id           String   @id @default(cuid())
  clinicId     String
  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  petId        String?
  pet          Pet?     @relation(fields: [petId], references: [id], onDelete: Cascade)
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  visitId      String?
  visit        Visit?   @relation(fields: [visitId], references: [id], onDelete: SetNull)
  uploadedById String?
  uploadedBy   User?    @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  name         String
  description  String?
  url          String
  mimeType     String?
  sizeBytes    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([clinicId, petId])
  @@index([clinicId, clientId])
  @@map("documents")
}

// ===========================================================================
// Audit log — who changed what, when
// ===========================================================================

// ===========================================================================
// Outbound messaging (WhatsApp appointment notifications)
// ===========================================================================

enum MessageChannel {
  SMS
  WHATSAPP
}

enum MessageKind {
  APPOINTMENT_CONFIRMATION
  APPOINTMENT_REMINDER
  REMINDER_DUE
}

enum MessageStatus {
  SENT
  FAILED
  MANUAL
  /// Composed, and deliberately not sent: an identical text had just
  /// gone to the same number, so the owner would have received the
  /// same words twice.
  ///
  /// Not `FAILED` -- nothing refused it and no attempt was spent --
  /// and certainly not `SENT`. It exists because the decision has to
  /// leave a trace: without a row, the reminder it belongs to is
  /// indistinguishable from one still waiting its turn, and the sweep
  /// would reconsider it on every run for ever.
  SUPPRESSED
}

/// What became of a message the provider accepted.
///
/// Separate from `MessageStatus` on purpose, and the two must never be
/// collapsed: `SENT` means the operator took it, and that is all it has
/// ever meant. Whether it reached a handset is a second fact that
/// arrives later, from a different call, and often not at all.
///
/// `UNKNOWN` and `PENDING` are both "not delivered yet" and they are
/// not the same thing. UNKNOWN is us: nobody has asked the provider.
/// PENDING is the provider: asked, and it does not know yet. A single
/// null for both would repeat the defect this whole day was spent
/// removing -- a zero that cannot say whether it is an answer or an
/// absence.
enum MessageDeliveryStatus {
  UNKNOWN
  PENDING
  DELIVERED
  UNDELIVERED
  EXPIRED
}

/// Every outbound message, whether the provider sent it or staff opened it
/// in WhatsApp by hand. Doubles as the dedupe source for reminders.
model MessageLog {
  id            String         @id @default(cuid())
  clinicId      String
  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  clientId      String?
  client        Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  reminderId    String?
  reminder      Reminder?      @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  channel       MessageChannel @default(SMS)
  kind          MessageKind
  recipient     String
  language      String
  body          String
  status        MessageStatus
  providerId    String?
  error         String?
  createdAt     DateTime       @default(now())

  /// Delivery, which is a different question from sending. Required and
  /// defaulted rather than nullable: "nobody has asked yet" is an
  /// answer and it has a name (`UNKNOWN`), where a null would have to
  /// stand for that and for "asked, still pending" at once.
  deliveryStatus    MessageDeliveryStatus @default(UNKNOWN)
  /// Only ever set when `deliveryStatus` is DELIVERED.
  deliveredAt       DateTime?
  /// The provider's own code, kept for tracing. Never shown on screen:
  /// it is their vocabulary, not a sentence about this clinic's work.
  deliveryCode      String?
  /// When the report was last asked for, so the poller can leave alone
  /// what it has just checked, and so a stalled poller is visible.
  deliveryCheckedAt DateTime?

  @@index([clinicId, createdAt])
  @@index([appointmentId, kind])
  @@index([reminderId, kind])
  /// The poller's own query: accepted messages whose delivery is still
  /// open, oldest first. Without this it is a scan of every message the
  /// clinic has ever sent, every fifteen minutes.
  @@index([deliveryStatus, createdAt])
  @@map("message_logs")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ARCHIVE
  RESTORE
  SIGNIN
  SIGNOUT
  SIGNUP
}

model AuditLog {
  id         String      @id @default(cuid())
  clinicId   String
  clinic     Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType String
  entityId   String
  changes    Json?
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([clinicId, createdAt])
  @@index([clinicId, entityType, entityId, createdAt])
  @@index([clinicId, actorId, createdAt])
  @@map("audit_logs")
}
